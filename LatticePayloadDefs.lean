import LatticePiecePointDefs
namespace LuRazClosure.SourcePieces
open LuRazLattice
noncomputable section
def payload (q e : Int) (i : Nat) (p : Int×Int) : Prop := match i with
  | 0 => (((3)*q+2)≤e ∧ e≤((4)*q))
  | 1 => ((5)≤e ∧ e≤(q+2))
  | 2 => ((5)≤e ∧ e≤(q+2)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 3 => (((2)*q+1)≤e ∧ e≤((4)*q))
  | 4 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 5 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1))
  | 6 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 7 => (((2)*q+3)≤e ∧ e≤((4)*q))
  | 8 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q))
  | 9 => ((5)≤e ∧ e≤((4)*q))
  | 10 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1))
  | 11 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 12 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+p.2)≤e ∧ e≤((4)*q))
  | 13 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+p.2+(-1))≤e ∧ e≤((4)*q))
  | 14 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+p.2)≤e ∧ e≤((4)*q))
  | 15 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+p.2+(-1))≤e ∧ e≤((4)*q))
  | 16 => (((4)*q)≤e ∧ e≤((4)*q))
  | 17 => ((5)≤e ∧ e≤(q+3)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 18 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 19 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 20 => ((5)≤e ∧ e≤((4)*q))
  | 21 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((2)*q+p.1)≤e ∧ e≤((4)*q))
  | 22 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((2)*q+p.1+(-1))≤e ∧ e≤((4)*q))
  | 23 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((4)*q+(-1)))
  | 24 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+p.1)≤e ∧ e≤((4)*q))
  | 25 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+p.2)≤e ∧ e≤((4)*q))
  | 26 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+p.2+(-1))≤e ∧ e≤((4)*q))
  | 27 => (((4)*q)≤e ∧ e≤((4)*q))
  | 28 => ((5)≤e ∧ e≤(q+3)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 29 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 30 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 31 => ((5)≤e ∧ e≤((4)*q))
  | 32 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((2)*q+p.1)≤e ∧ e≤((4)*q))
  | 33 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((2)*q+p.1+(-1))≤e ∧ e≤((4)*q))
  | 34 => ((5)≤e ∧ e≤((2)*q+2)) ∨ (((3)*q+1)≤e ∧ e≤((4)*q+(-1)))
  | 35 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q))
  | 36 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q))
  | 37 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q))
  | 38 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 39 => ((p.1)≤e ∧ e≤(p.2))
  | 40 => ((p.1)≤e ∧ e≤(p.2))
  | 41 => ((5)≤e ∧ e≤(q+2)) ∨ ((p.1)≤e ∧ e≤(p.2))
  | 42 => ((p.1)≤e ∧ e≤(p.2)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 43 => ((p.1)≤e ∧ e≤(p.2)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 44 => ((p.1)≤e ∧ e≤((4)*q))
  | 45 => ((5)≤e ∧ e≤(q+2)) ∨ ((q+4)≤e ∧ e≤((3)*q)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 46 => ((5)≤e ∧ e≤(q+2)) ∨ ((p.1)≤e ∧ e≤((4)*q))
  | 47 => (((2)*q+2)≤e ∧ e≤((4)*q+(-2)))
  | 48 => (((2)*q+3)≤e ∧ e≤((4)*q+(-1)))
  | 49 => (((2)*q+2)≤e ∧ e≤((4)*q+(-1)))
  | 50 => (((2)*q+2)≤e ∧ e≤((4)*q))
  | 51 => (((2)*q+3)≤e ∧ e≤((4)*q))
  | 52 => (((2)*q+1)≤e ∧ e≤((4)*q))
  | 53 => ((p.1)≤e ∧ e≤(p.2))
  | 54 => ((5)≤e ∧ e≤(q+2)) ∨ ((p.1)≤e ∧ e≤(p.2))
  | 55 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+2)≤e ∧ e≤((4)*q+(-2)))
  | 56 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q+(-1)))
  | 57 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+2)≤e ∧ e≤((4)*q+(-1)))
  | 58 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+2)≤e ∧ e≤((4)*q))
  | 59 => ((5)≤e ∧ e≤(q+2)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q))
  | 60 => ((p.1)≤e ∧ e≤((4)*q))
  | 61 => ((5)≤e ∧ e≤(q+2)) ∨ ((p.1)≤e ∧ e≤((4)*q))
  | 62 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1))
  | 63 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1))
  | 64 => ((5)≤e ∧ e≤(p.1)) ∨ (((4)*q)≤e ∧ e≤((4)*q))
  | 65 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ (((4)*q)≤e ∧ e≤((4)*q))
  | 66 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 67 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+1)≤e ∧ e≤((4)*q))
  | 68 => ((5)≤e ∧ e≤((2)*q)) ∨ (((4)*q)≤e ∧ e≤((4)*q))
  | 69 => ((5)≤e ∧ e≤((2)*q)) ∨ (((4)*q)≤e ∧ e≤((4)*q)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q))
  | 70 => ((5)≤e ∧ e≤((2)*q)) ∨ (((4)*q)≤e ∧ e≤((4)*q)) ∨ (((2)*q+3)≤e ∧ e≤((4)*q))
  | 71 => ((5)≤e ∧ e≤(p.1)) ∨ ((p.2)≤e ∧ e≤((4)*q))
  | 72 => ((5)≤e ∧ e≤(p.1)) ∨ ((p.2)≤e ∧ e≤((4)*q))
  | 73 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 74 => ((5)≤e ∧ e≤(p.1)) ∨ (((2)*q+1)≤e ∧ e≤((4)*q))
  | 75 => ((5)≤e ∧ e≤(q+3)) ∨ ((p.1)≤e ∧ e≤((4)*q+(-1)))
  | 76 => ((5)≤e ∧ e≤(p.1))
  | 77 => ((5)≤e ∧ e≤((4)*q+(-2))) ∨ (((4)*q)≤e ∧ e≤((4)*q))
  | 78 => ((5)≤e ∧ e≤(p.1))
  | 79 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+2)≤e ∧ e≤((4)*q+(-1)))
  | 80 => ((5)≤e ∧ e≤(q+3)) ∨ ((p.1)≤e ∧ e≤((4)*q+(-1)))
  | 81 => ((5)≤e ∧ e≤(q+3)) ∨ ((p.1)≤e ∧ e≤((4)*q+(-1)))
  | 82 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+1)≤e ∧ e≤((4)*q+(-1)))
  | 83 => ((5)≤e ∧ e≤(p.1)) ∨ ((p.2)≤e ∧ e≤((4)*q))
  | 84 => ((5)≤e ∧ e≤((2)*q)) ∨ ((p.1)≤e ∧ e≤((4)*q))
  | 85 => ((5)≤e ∧ e≤((2)*q)) ∨ (((2)*q+2)≤e ∧ e≤((4)*q+(-2))) ∨ (((4)*q)≤e ∧ e≤((4)*q))
  | 86 => ((5)≤e ∧ e≤((2)*q+1)) ∨ ((p.1)≤e ∧ e≤((4)*q))
  | 87 => ((p.1)≤e ∧ e≤((4)*q))
  | 88 => ((5)≤e ∧ e≤(p.1)) ∨ ((p.2)≤e ∧ e≤((4)*q))
  | 89 => ((5)≤e ∧ e≤((4)*q))
  | 90 => ((5)≤e ∧ e≤(p.1)) ∨ ((p.2)≤e ∧ e≤((4)*q))
  | 91 => ((5)≤e ∧ e≤(p.1)) ∨ (((3)*q+1)≤e ∧ e≤((3)*q+1)) ∨ ((p.2)≤e ∧ e≤((4)*q))
  | _ => False
def rawPieceEvent (q i e : Nat) (p : Int×Int) : Prop := pieceSet q i p.1.toNat p.2.toNat e
end
end LuRazClosure.SourcePieces
