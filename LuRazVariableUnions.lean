import LuRazClosureLemmas

/-! Exact semantic normal forms for arbitrary nonempty finite unions of each
    of the two variable tail families. No finite bound on q or list length. -/
namespace LuRazClosure

set_option maxRecDepth 32768
set_option maxHeartbeats 8000000

def ListUnion (f : Nat → Nat → Prop) (l : List Nat) (e : Nat) : Prop :=
  ∃ a, a ∈ l ∧ f a e

theorem listUnion_cons (f : Nat → Nat → Prop) (a : Nat) (l : List Nat) (e : Nat) :
    ListUnion f (a::l) e ↔ f a e ∨ ListUnion f l e := by
  constructor
  · rintro ⟨b,hb,hbe⟩
    rcases List.mem_cons.mp hb with h | h
    · subst b; exact Or.inl hbe
    · exact Or.inr ⟨b,h,hbe⟩
  · intro h
    rcases h with h | h
    · exact ⟨a,List.mem_cons.mpr (Or.inl rfl),h⟩
    · obtain ⟨b,hb,hbe⟩ := h
      exact ⟨b,List.mem_cons.mpr (Or.inr hb),hbe⟩

theorem JReachable_join (q a b c d : Nat) (hq : 4 ≤ q)
    (hab : JReachable q a b) (hcd : JReachable q c d) :
    JReachable q (min a c) (max b d) := by
  have hma : 5 ≤ min a c := by unfold JReachable at hab hcd; omega
  have hmu : min a c ≤ 2*q+1 := by unfold JReachable at hab hcd; omega
  have hmg := g_monotone q (min a c) a hq hma hab.2.1 (by omega)
  unfold JReachable at hab hcd ⊢
  omega

theorem J_single_reachable (q a : Nat) (hq : 4 ≤ q)
    (ha : 5 ≤ a ∧ a ≤ 2*q+1) : JReachable q a (g q a) := by
  have hg := g_bounds q a hq ha
  exact ⟨ha.1,ha.2,hg.1,hg.2,by omega⟩

/-- Complete all-parameter classification of every nonempty list union of J tails. -/
theorem J_list_normal_form (q : Nat) (hq : 4 ≤ q) (l : List Nat)
    (hne : l ≠ []) (hvalid : ∀ a ∈ l, 5 ≤ a ∧ a ≤ 2*q+1) :
    ∃ a b, JReachable q a b ∧
      ∀ e, ListUnion (fun t => I t (g q t)) l e ↔ I a b e := by
  induction l with
  | nil => exact False.elim (hne rfl)
  | cons t rest ih =>
    have ht := hvalid t (by simp)
    have htr := J_single_reachable q t hq ht
    by_cases hempty : rest=[]
    · subst rest
      refine ⟨t,g q t,htr,?_⟩
      intro e
      constructor
      · rintro ⟨a,ha,hae⟩
        have hat : a=t := by simpa using ha
        subst a; exact hae
      · intro h
        exact ⟨t,by simp,h⟩
    · have hrv : ∀ a ∈ rest, 5 ≤ a ∧ a ≤ 2*q+1 := by
        intro a ha
        exact hvalid a (by simp only [List.mem_cons]; exact Or.inr ha)
      obtain ⟨a,b,hab,heq⟩ := ih hempty hrv
      refine ⟨min t a,max (g q t) b,JReachable_join q t (g q t) a b hq htr hab,?_⟩
      intro e
      rw [listUnion_cons,heq]
      exact J_join_closed q t (g q t) a b e hq htr hab

/-- Conversely every reachable interval is generated by a nonempty J list. -/
theorem J_normal_form_attainable (q a b : Nat) (hq : 4 ≤ q)
    (hab : JReachable q a b) :
    ∃ l : List Nat, l ≠ [] ∧
      (∀ t ∈ l, 5 ≤ t ∧ t ≤ 2*q+1) ∧
      ∀ e, ListUnion (fun t => I t (g q t)) l e ↔ I a b e := by
  obtain ⟨c,hc,hac⟩ := J_pair_attains q a b hq hab
  refine ⟨[a,c],by simp,?_,?_⟩
  · intro t ht
    simp only [List.mem_cons,List.not_mem_nil,or_false] at ht
    rcases ht with h | h
    · subst t; exact ⟨hab.1,hab.2.1⟩
    · subst t; exact hc
  · intro e
    rw [listUnion_cons,listUnion_cons]
    have hn : ¬ListUnion (fun t => I t (g q t)) [] e := by
      rintro ⟨t,ht,_⟩; exact List.not_mem_nil ht
    simp only [hn,or_false]
    exact hac e

def LNormal (q t p e : Nat) : Prop :=
  I 5 p e ∨ I (beta q t) (if t=q+3 ∧ p=q+3 then 4*q-1 else 4*q) e

theorem L_single_normal (q p e : Nat) :
    LNormal q p p e ↔ I 5 p e ∨ I (beta q p) (LEnd q p) e := by
  simp only [LNormal,LEnd,and_self]

theorem P_min (q t u : Nat) (ht : P q t) (hu : P q u) : P q (min t u) := by
  unfold P at *
  omega

theorem P_max (q p v : Nat) (hp : P q p) (hv : P q v) : P q (max p v) := by
  unfold P at *
  omega

/-- The M exception survives exactly when both extrema equal q+3. -/
theorem L_join_normal (q t p u v e : Nat) (hq : 4 ≤ q)
    (ht : P q t) (hp : P q p) (hu : P q u) (hv : P q v)
    (htp : t ≤ p) (huv : u ≤ v) :
    (LNormal q t p e ∨ LNormal q u v e) ↔
      LNormal q (min t u) (max p v) e := by
  have hbt := beta_bounds q t hq ht
  have hbu := beta_bounds q u hq hu
  unfold P at ht hp hu hv
  unfold LNormal I beta
  by_cases htu : t ≤ u <;> by_cases hpv : p ≤ v
  · rw [Nat.min_eq_left htu,Nat.max_eq_right hpv]
    repeat first | omega | split
  · have hvl : v ≤ p := by omega
    rw [Nat.min_eq_left htu,Nat.max_eq_left hvl]
    repeat first | omega | split
  · have hut : u ≤ t := by omega
    rw [Nat.min_eq_right hut,Nat.max_eq_right hpv]
    repeat first | omega | split
  · have hut : u ≤ t := by omega
    have hvl : v ≤ p := by omega
    rw [Nat.min_eq_right hut,Nat.max_eq_left hvl]
    repeat first | omega | split

/-- Complete semantic classification of arbitrary nonempty L tail unions. -/
theorem L_list_normal_form (q : Nat) (hq : 4 ≤ q) (l : List Nat)
    (hne : l ≠ []) (hvalid : ∀ p ∈ l, P q p) :
    ∃ t p, P q t ∧ P q p ∧ t ≤ p ∧
      ∀ e, ListUnion (fun a => LNormal q a a) l e ↔ LNormal q t p e := by
  induction l with
  | nil => exact False.elim (hne rfl)
  | cons a rest ih =>
    have ha := hvalid a (by simp)
    by_cases hempty : rest=[]
    · subst rest
      refine ⟨a,a,ha,ha,by omega,?_⟩
      intro e
      constructor
      · rintro ⟨b,hb,hbe⟩
        have hba : b=a := by simpa using hb
        subst b; exact hbe
      · intro h
        exact ⟨a,by simp,h⟩
    · have hrv : ∀ p ∈ rest, P q p := by
        intro p hp
        exact hvalid p (by simp only [List.mem_cons]; exact Or.inr hp)
      obtain ⟨t,p,ht,hp,htp,heq⟩ := ih hempty hrv
      refine ⟨min a t,max a p,P_min q a t ha ht,P_max q a p ha hp,by omega,?_⟩
      intro e
      rw [listUnion_cons,heq]
      exact L_join_normal q a a t p e hq ha ha ht hp (by omega) htp

theorem L_normal_form_attainable (q t p : Nat) (hq : 4 ≤ q)
    (ht : P q t) (hp : P q p) (htp : t ≤ p) :
    ∃ l : List Nat, l ≠ [] ∧ (∀ a ∈ l, P q a) ∧
      ∀ e, ListUnion (fun a => LNormal q a a) l e ↔ LNormal q t p e := by
  refine ⟨[t,p],by simp,?_,?_⟩
  · intro a ha
    simp only [List.mem_cons,List.not_mem_nil,or_false] at ha
    rcases ha with h | h
    · subst a; exact ht
    · subst a; exact hp
  · intro e
    rw [listUnion_cons,listUnion_cons]
    have hn : ¬ListUnion (fun a => LNormal q a a) [] e := by
      rintro ⟨a,ha,_⟩; exact List.not_mem_nil ha
    simp only [hn,or_false]
    have heq := L_join_normal q t t p p e hq ht ht hp hp (by omega) (by omega)
    simpa only [Nat.min_eq_left htp,Nat.max_eq_right htp] using heq

theorem list_nonempty_witness (l : List Nat) (hne : l ≠ []) : ∃ a, a ∈ l := by
  cases l with
  | nil => exact False.elim (hne rfl)
  | cons a rest => exact ⟨a,by simp⟩

theorem listUnion_congr (f g : Nat → Nat → Prop) (l : List Nat)
    (h : ∀ a ∈ l, ∀ e, f a e ↔ g a e) (e : Nat) :
    ListUnion f l e ↔ ListUnion g l e := by
  constructor
  · rintro ⟨a,ha,he⟩
    exact ⟨a,ha,(h a ha e).mp he⟩
  · rintro ⟨a,ha,he⟩
    exact ⟨a,ha,(h a ha e).mpr he⟩

theorem listUnion_fixed_core (core : Nat → Prop) (f : Nat → Nat → Prop)
    (l : List Nat) (hne : l ≠ []) (e : Nat) :
    ListUnion (fun a e => core e ∨ f a e) l e ↔ core e ∨ ListUnion f l e := by
  constructor
  · rintro ⟨a,ha,he⟩
    rcases he with h | h
    · exact Or.inl h
    · exact Or.inr ⟨a,ha,h⟩
  · intro he
    rcases he with h | h
    · obtain ⟨a,ha⟩ := list_nonempty_witness l hne
      exact ⟨a,ha,Or.inl h⟩
    · obtain ⟨a,ha,he⟩ := h
      exact ⟨a,ha,Or.inr he⟩

/-- This statement uses the original Row predicates, not just isolated tails. -/
theorem J_source_list_normal_form (q : Nat) (hq : 4 ≤ q) (l : List Nat)
    (hne : l ≠ []) (hvalid : ∀ a ∈ l, 5 ≤ a ∧ a ≤ 2*q+1) :
    ∃ a b, JReachable q a b ∧
      ∀ e, ListUnion (fun t => LuRazParametric.Row q (JIndex t)) l e ↔
        e=1 ∨ e=4 ∨ I a b e := by
  obtain ⟨a,b,hab,heq⟩ := J_list_normal_form q hq l hne hvalid
  refine ⟨a,b,hab,?_⟩
  intro e
  have hrows : ∀ t ∈ l, ∀ e,
      LuRazParametric.Row q (JIndex t) e ↔ (e=1 ∨ e=4) ∨ I t (g q t) e := by
    intro t ht e
    rw [J_is_source_row q t e hq (hvalid t ht)]
    exact or_assoc.symm
  rw [listUnion_congr _ _ l hrows e,listUnion_fixed_core _ _ l hne e,heq e]
  exact or_assoc

/-- The exceptional M suffix is preserved in the source-row list semantics. -/
theorem L_source_list_normal_form (q : Nat) (hq : 4 ≤ q) (l : List Nat)
    (hne : l ≠ []) (hvalid : ∀ p ∈ l, P q p) :
    ∃ t p, P q t ∧ P q p ∧ t ≤ p ∧
      ∀ e, ListUnion (fun a => LuRazParametric.Row q (LIndex q a)) l e ↔
        e=2 ∨ e=3 ∨ LNormal q t p e := by
  obtain ⟨t,p,ht,hp,htp,heq⟩ := L_list_normal_form q hq l hne hvalid
  refine ⟨t,p,ht,hp,htp,?_⟩
  intro e
  have hrows : ∀ a ∈ l, ∀ e,
      LuRazParametric.Row q (LIndex q a) e ↔ (e=2 ∨ e=3) ∨ LNormal q a a e := by
    intro a ha e
    rw [L_is_source_row q a e hq (hvalid a ha),L_single_normal]
    exact or_assoc.symm
  rw [listUnion_congr _ _ l hrows e,listUnion_fixed_core _ _ l hne e,heq e]
  exact or_assoc

theorem J_source_attainable (q a b : Nat) (hq : 4 ≤ q)
    (hab : JReachable q a b) :
    ∃ l : List Nat, l ≠ [] ∧ (∀ t ∈ l, 5 ≤ t ∧ t ≤ 2*q+1) ∧
      ∀ e, ListUnion (fun t => LuRazParametric.Row q (JIndex t)) l e ↔
        e=1 ∨ e=4 ∨ I a b e := by
  obtain ⟨l,hne,hvalid,heq⟩ := J_normal_form_attainable q a b hq hab
  refine ⟨l,hne,hvalid,?_⟩
  intro e
  have hrows : ∀ t ∈ l, ∀ e,
      LuRazParametric.Row q (JIndex t) e ↔ (e=1 ∨ e=4) ∨ I t (g q t) e := by
    intro t ht e
    rw [J_is_source_row q t e hq (hvalid t ht)]
    exact or_assoc.symm
  rw [listUnion_congr _ _ l hrows e,listUnion_fixed_core _ _ l hne e,heq e]
  exact or_assoc

theorem L_source_attainable (q t p : Nat) (hq : 4 ≤ q)
    (ht : P q t) (hp : P q p) (htp : t ≤ p) :
    ∃ l : List Nat, l ≠ [] ∧ (∀ a ∈ l, P q a) ∧
      ∀ e, ListUnion (fun a => LuRazParametric.Row q (LIndex q a)) l e ↔
        e=2 ∨ e=3 ∨ LNormal q t p e := by
  obtain ⟨l,hne,hvalid,heq⟩ := L_normal_form_attainable q t p hq ht hp htp
  refine ⟨l,hne,hvalid,?_⟩
  intro e
  have hrows : ∀ a ∈ l, ∀ e,
      LuRazParametric.Row q (LIndex q a) e ↔ (e=2 ∨ e=3) ∨ LNormal q a a e := by
    intro a ha e
    rw [L_is_source_row q a e hq (hvalid a ha),L_single_normal]
    exact or_assoc.symm
  rw [listUnion_congr _ _ l hrows e,listUnion_fixed_core _ _ l hne e,heq e]
  exact or_assoc

def JGenerated (q : Nat) (R : Nat → Prop) : Prop :=
  ∃ l : List Nat, l ≠ [] ∧ (∀ a ∈ l, 5 ≤ a ∧ a ≤ 2*q+1) ∧
    ∀ e, ListUnion (fun a => LuRazParametric.Row q (JIndex a)) l e ↔ R e

def LGenerated (q : Nat) (R : Nat → Prop) : Prop :=
  ∃ l : List Nat, l ≠ [] ∧ (∀ p ∈ l, P q p) ∧
    ∀ e, ListUnion (fun p => LuRazParametric.Row q (LIndex q p)) l e ↔ R e

/-- Exact closure semantics for the J subfamily, in both directions. -/
theorem J_closure_exact (q : Nat) (hq : 4 ≤ q) (R : Nat → Prop) :
    JGenerated q R ↔ ∃ a b, JReachable q a b ∧
      ∀ e, R e ↔ e=1 ∨ e=4 ∨ I a b e := by
  constructor
  · rintro ⟨l,hne,hvalid,hR⟩
    obtain ⟨a,b,hab,heq⟩ := J_source_list_normal_form q hq l hne hvalid
    refine ⟨a,b,hab,?_⟩
    intro e
    exact (hR e).symm.trans (heq e)
  · rintro ⟨a,b,hab,hR⟩
    obtain ⟨l,hne,hvalid,heq⟩ := J_source_attainable q a b hq hab
    refine ⟨l,hne,hvalid,?_⟩
    intro e
    exact (heq e).trans (hR e).symm

/-- Exact closure semantics for the L subfamily, including its exceptional row. -/
theorem L_closure_exact (q : Nat) (hq : 4 ≤ q) (R : Nat → Prop) :
    LGenerated q R ↔ ∃ t p, P q t ∧ P q p ∧ t ≤ p ∧
      ∀ e, R e ↔ e=2 ∨ e=3 ∨ LNormal q t p e := by
  constructor
  · rintro ⟨l,hne,hvalid,hR⟩
    obtain ⟨t,p,ht,hp,htp,heq⟩ := L_source_list_normal_form q hq l hne hvalid
    refine ⟨t,p,ht,hp,htp,?_⟩
    intro e
    exact (hR e).symm.trans (heq e)
  · rintro ⟨t,p,ht,hp,htp,hR⟩
    obtain ⟨l,hne,hvalid,heq⟩ := L_source_attainable q t p hq ht hp htp
    refine ⟨l,hne,hvalid,?_⟩
    intro e
    exact (heq e).trans (hR e).symm

end LuRazClosure
