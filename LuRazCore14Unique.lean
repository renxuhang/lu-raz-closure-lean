    | doubleGap  =>
      have h0 := heq (4*q)
      change ((4*q)=1 ∨ (4*q)=4 ∨ (a≤(4*q) ∧ (4*q)≤b)) ↔ (((4*q)=1 ∨ (4*q)=4 ∨ (q+4≤(4*q) ∧ (4*q)≤3*q)) ∨ ((4*q)=1 ∨ (5≤(4*q) ∧ (4*q)≤q+2)) ∨ (3*q+2≤(4*q) ∧ (4*q)≤4*q)) at h0
