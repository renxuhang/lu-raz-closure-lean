      have h1 := heq (5)
      change (((5)=1 ∨ (5)=4 ∨ (a≤(5) ∧ (5)≤b)) ∨ ((5)=1 ∨ (5≤(5) ∧ (5)≤q+2))) ↔ ((5)=1 ∨ (5)=4 ∨ (c≤(5) ∧ (5)≤d)) at h1
      have h2 := heq (q+3)
