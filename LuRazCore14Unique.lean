      have h1 := heq (b)
      change (((b)=1 ∨ (b)=4 ∨ (a≤(b) ∧ (b)≤b)) ∨ ((b)=1 ∨ (5≤(b) ∧ (b)≤q+2))) ↔ (((b)=1 ∨ (b)=4 ∨ (c≤(b) ∧ (b)≤d)) ∨ ((b)=1 ∨ (5≤(b) ∧ (b)≤q+2))) at h1
      have h2 := heq (c)
      change (((c)=1 ∨ (c)=4 ∨ (a≤(c) ∧ (c)≤b)) ∨ ((c)=1 ∨ (5≤(c) ∧ (c)≤q+2))) ↔ (((c)=1 ∨ (c)=4 ∨ (c≤(c) ∧ (c)≤d)) ∨ ((c)=1 ∨ (5≤(c) ∧ (c)≤q+2))) at h2
