      have h3 := heq (3*q+1)
      change (((3*q+1)=1 ∨ (3*q+1)=4 ∨ (a≤(3*q+1) ∧ (3*q+1)≤b)) ∨ ((3*q+1)=1 ∨ (5≤(3*q+1) ∧ (3*q+1)≤q+2))) ↔ ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (c≤(3*q+1) ∧ (3*q+1)≤d)) at h3
