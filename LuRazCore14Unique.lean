      change ((q+3)=1 ∨ (q+3)=4 ∨ (a≤(q+3) ∧ (q+3)≤b)) ↔ (((q+3)=1 ∨ (q+3)=4 ∨ (q+4≤(q+3) ∧ (q+3)≤3*q)) ∨ ((q+3)=1 ∨ (5≤(q+3) ∧ (q+3)≤q+2)) ∨ (3*q+2≤(q+3) ∧ (q+3)≤4*q)) at h2
      have h3 := heq (3*q+1)
      change ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (a≤(3*q+1) ∧ (3*q+1)≤b)) ↔ (((3*q+1)=1 ∨ (3*q+1)=4 ∨ (q+4≤(3*q+1) ∧ (3*q+1)≤3*q)) ∨ ((3*q+1)=1 ∨ (5≤(3*q+1) ∧ (3*q+1)≤q+2)) ∨ (3*q+2≤(3*q+1) ∧ (3*q+1)≤4*q)) at h3
      exfalso
      omega
    | ajoined c =>
      have hwb : q+4≤c ∧ c≤2*q+1 := hw
      have h0 := heq (4*q)
      change ((4*q)=1 ∨ (4*q)=4 ∨ (a≤(4*q) ∧ (4*q)≤b)) ↔ (((4*q)=1 ∨ (4*q)=4 ∨ (c≤(4*q) ∧ (4*q)≤4*q)) ∨ ((4*q)=1 ∨ (5≤(4*q) ∧ (4*q)≤q+2))) at h0
