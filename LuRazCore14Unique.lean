import LuRazCore14Normal
namespace LuRazClosure
set_option maxRecDepth 32768
set_option maxHeartbeats 8000000

/-- The six classes are disjoint and all their parameters are uniquely recovered. -/
theorem NF14.unique (q : Nat) (hq : 4 ≤ q) (z w : NF14)
    (hz : z.Valid q) (hw : w.Valid q) (heq : ∀ e, z.eval q e ↔ w.eval q e) : z=w := by
  cases z with
  | base a b =>
    have hzb : 5≤a ∧ a≤2*q+1 ∧ 2*q+2≤b ∧ b≤4*q-3 := ⟨hz.1,hz.2.1,hz.2.2.1,hz.2.2.2.1⟩
    cases w with
    | base c d =>
      have hwb : 5≤c ∧ c≤2*q+1 ∧ 2*q+2≤d ∧ d≤4*q-3 := ⟨hw.1,hw.2.1,hw.2.2.1,hw.2.2.2.1⟩
      have h0 := heq (a)
      change ((a)=1 ∨ (a)=4 ∨ (a≤(a) ∧ (a)≤b)) ↔ ((a)=1 ∨ (a)=4 ∨ (c≤(a) ∧ (a)≤d)) at h0
      have h1 := heq (b)
      change ((b)=1 ∨ (b)=4 ∨ (a≤(b) ∧ (b)≤b)) ↔ ((b)=1 ∨ (b)=4 ∨ (c≤(b) ∧ (b)≤d)) at h1
      have h2 := heq (c)
      change ((c)=1 ∨ (c)=4 ∨ (a≤(c) ∧ (c)≤b)) ↔ ((c)=1 ∨ (c)=4 ∨ (c≤(c) ∧ (c)≤d)) at h2
      have h3 := heq (d)
      change ((d)=1 ∨ (d)=4 ∨ (a≤(d) ∧ (d)≤b)) ↔ ((d)=1 ∨ (d)=4 ∨ (c≤(d) ∧ (d)≤d)) at h3
      have hac : a=c := by omega
      have hbd : b=d := by omega
      subst c; subst d; rfl
    | agap c d =>
      have hwb : 5≤c ∧ c≤2*q+1 ∧ 2*q+2≤d ∧ d≤4*q-3 ∧ q+4≤c := ⟨hw.1.1,hw.1.2.1,hw.1.2.2.1,hw.1.2.2.2.1,hw.2⟩
      have h0 := heq (4*q)
      change ((4*q)=1 ∨ (4*q)=4 ∨ (a≤(4*q) ∧ (4*q)≤b)) ↔ (((4*q)=1 ∨ (4*q)=4 ∨ (c≤(4*q) ∧ (4*q)≤d)) ∨ ((4*q)=1 ∨ (5≤(4*q) ∧ (4*q)≤q+2))) at h0
      have h1 := heq (5)
      change ((5)=1 ∨ (5)=4 ∨ (a≤(5) ∧ (5)≤b)) ↔ (((5)=1 ∨ (5)=4 ∨ (c≤(5) ∧ (5)≤d)) ∨ ((5)=1 ∨ (5≤(5) ∧ (5)≤q+2))) at h1
      have h2 := heq (q+3)
      change ((q+3)=1 ∨ (q+3)=4 ∨ (a≤(q+3) ∧ (q+3)≤b)) ↔ (((q+3)=1 ∨ (q+3)=4 ∨ (c≤(q+3) ∧ (q+3)≤d)) ∨ ((q+3)=1 ∨ (5≤(q+3) ∧ (q+3)≤q+2))) at h2
      have h3 := heq (3*q+1)
      change ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (a≤(3*q+1) ∧ (3*q+1)≤b)) ↔ (((3*q+1)=1 ∨ (3*q+1)=4 ∨ (c≤(3*q+1) ∧ (3*q+1)≤d)) ∨ ((3*q+1)=1 ∨ (5≤(3*q+1) ∧ (3*q+1)≤q+2))) at h3
      exfalso
      omega
    | bgap c d =>
      have hwb : 5≤c ∧ c≤2*q+1 ∧ 2*q+2≤d ∧ d≤4*q-3 ∧ d≤3*q := ⟨hw.1.1,hw.1.2.1,hw.1.2.2.1,hw.1.2.2.2.1,hw.2⟩
      have h0 := heq (4*q)
      change ((4*q)=1 ∨ (4*q)=4 ∨ (a≤(4*q) ∧ (4*q)≤b)) ↔ (((4*q)=1 ∨ (4*q)=4 ∨ (c≤(4*q) ∧ (4*q)≤d)) ∨ (3*q+2≤(4*q) ∧ (4*q)≤4*q)) at h0
      have h1 := heq (5)
      change ((5)=1 ∨ (5)=4 ∨ (a≤(5) ∧ (5)≤b)) ↔ (((5)=1 ∨ (5)=4 ∨ (c≤(5) ∧ (5)≤d)) ∨ (3*q+2≤(5) ∧ (5)≤4*q)) at h1
      have h2 := heq (q+3)
      change ((q+3)=1 ∨ (q+3)=4 ∨ (a≤(q+3) ∧ (q+3)≤b)) ↔ (((q+3)=1 ∨ (q+3)=4 ∨ (c≤(q+3) ∧ (q+3)≤d)) ∨ (3*q+2≤(q+3) ∧ (q+3)≤4*q)) at h2
      have h3 := heq (3*q+1)
      change ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (a≤(3*q+1) ∧ (3*q+1)≤b)) ↔ (((3*q+1)=1 ∨ (3*q+1)=4 ∨ (c≤(3*q+1) ∧ (3*q+1)≤d)) ∨ (3*q+2≤(3*q+1) ∧ (3*q+1)≤4*q)) at h3
      exfalso
      omega
    | joined c =>
      have hwb : 5≤c ∧ c≤2*q+1 := hw
      have h0 := heq (4*q)
      change ((4*q)=1 ∨ (4*q)=4 ∨ (a≤(4*q) ∧ (4*q)≤b)) ↔ ((4*q)=1 ∨ (4*q)=4 ∨ (c≤(4*q) ∧ (4*q)≤4*q)) at h0
      have h1 := heq (5)
      change ((5)=1 ∨ (5)=4 ∨ (a≤(5) ∧ (5)≤b)) ↔ ((5)=1 ∨ (5)=4 ∨ (c≤(5) ∧ (5)≤4*q)) at h1
      have h2 := heq (q+3)
      change ((q+3)=1 ∨ (q+3)=4 ∨ (a≤(q+3) ∧ (q+3)≤b)) ↔ ((q+3)=1 ∨ (q+3)=4 ∨ (c≤(q+3) ∧ (q+3)≤4*q)) at h2
      have h3 := heq (3*q+1)
      change ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (a≤(3*q+1) ∧ (3*q+1)≤b)) ↔ ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (c≤(3*q+1) ∧ (3*q+1)≤4*q)) at h3
      exfalso
