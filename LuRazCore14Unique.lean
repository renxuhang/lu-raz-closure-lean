      have h0 := heq (4*q)
      change (((4*q)=1 ∨ (4*q)=4 ∨ (a≤(4*q) ∧ (4*q)≤b)) ∨ ((4*q)=1 ∨ (5≤(4*q) ∧ (4*q)≤q+2))) ↔ (((4*q)=1 ∨ (4*q)=4 ∨ (c≤(4*q) ∧ (4*q)≤d)) ∨ (3*q+2≤(4*q) ∧ (4*q)≤4*q)) at h0
      have h1 := heq (5)
      change (((5)=1 ∨ (5)=4 ∨ (a≤(5) ∧ (5)≤b)) ∨ ((5)=1 ∨ (5≤(5) ∧ (5)≤q+2))) ↔ (((5)=1 ∨ (5)=4 ∨ (c≤(5) ∧ (5)≤d)) ∨ (3*q+2≤(5) ∧ (5)≤4*q)) at h1
      have h2 := heq (q+3)
      change (((q+3)=1 ∨ (q+3)=4 ∨ (a≤(q+3) ∧ (q+3)≤b)) ∨ ((q+3)=1 ∨ (5≤(q+3) ∧ (q+3)≤q+2))) ↔ (((q+3)=1 ∨ (q+3)=4 ∨ (c≤(q+3) ∧ (q+3)≤d)) ∨ (3*q+2≤(q+3) ∧ (q+3)≤4*q)) at h2
      have h3 := heq (3*q+1)
