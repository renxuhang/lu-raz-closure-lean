      have h2 := heq (q+3)
      change ((q+3)=1 ∨ (q+3)=4 ∨ (a≤(q+3) ∧ (q+3)≤b)) ↔ (((q+3)=1 ∨ (q+3)=4 ∨ (c≤(q+3) ∧ (q+3)≤4*q)) ∨ ((q+3)=1 ∨ (5≤(q+3) ∧ (q+3)≤q+2))) at h2
      have h3 := heq (3*q+1)
      change ((3*q+1)=1 ∨ (3*q+1)=4 ∨ (a≤(3*q+1) ∧ (3*q+1)≤b)) ↔ (((3*q+1)=1 ∨ (3*q+1)=4 ∨ (c≤(3*q+1) ∧ (3*q+1)≤4*q)) ∨ ((3*q+1)=1 ∨ (5≤(3*q+1) ∧ (3*q+1)≤q+2))) at h3
